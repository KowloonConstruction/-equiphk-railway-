# ─────────────────────────────────────────────────────────────────────────────
# EquipHK — Railway Environment Variables
# Copy this file, fill in all values, and add them to Railway → Variables
# DO NOT commit this file with real values to GitHub
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────────────────────
NODE_ENV=production

# Database — use the MySQL URL from Railway's MySQL service (Connect tab)
DATABASE_URL=mysql://root:PASSWORD@mysql.railway.internal:3306/railway

# Session signing secret — generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_HEX_STRING

# ── Authentication ────────────────────────────────────────────────────────────
# Owner's admin email (used to seed the first admin account)
OWNER_EMAIL=casey@kowloonconstruction.com
OWNER_OPEN_ID=casey-admin

# ── LLM (OpenAI) ─────────────────────────────────────────────────────────────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── Storage (AWS S3 or Cloudflare R2) ────────────────────────────────────────
# Option A: AWS S3
S3_BUCKET=equiphk-assets
S3_REGION=ap-east-1
S3_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
S3_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Option B: Cloudflare R2 (uncomment and fill in)
# S3_BUCKET=equiphk-assets
# S3_REGION=auto
# S3_ACCESS_KEY_ID=your-r2-access-key-id
# S3_SECRET_ACCESS_KEY=your-r2-secret-access-key
# S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=EquipHK <noreply@equip.hk>

# ── Payments (Stripe) ────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Google Drive Backup ───────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_OAUTH_CLIENT_ID=...
GOOGLE_OAUTH_CLIENT_SECRET=...
GOOGLE_OAUTH_REFRESH_TOKEN=...

# ── GitHub Backup ─────────────────────────────────────────────────────────────
# SSH deploy key — add the public key to your GitHub repo → Settings → Deploy Keys
# The private key content goes here (base64 encoded)
# Generate with: ssh-keygen -t ed25519 -C "equiphk-railway-backup"
# Then: cat ~/.ssh/equiphk-deploy-key | base64 -w 0
GITHUB_DEPLOY_KEY_B64=...
GITHUB_BACKUP_REPO=git@github.com:EquipHK/Equip-HK---backup-.git
